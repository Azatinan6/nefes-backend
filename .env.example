# Nefes Backend Environment Variables
# Bu dosyayı kopyalayarak '.env' adında yeni bir dosya oluşturun ve değerleri kendi ortamınıza göre doldurun.
# .env dosyası .gitignore'a eklenmiştir ve GitHub'a yüklenmeyecektir.

# Veritabanı
DB_URL=jdbc:postgresql://localhost:5432/nefes_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Yapay Zeka (Gemini API Anahtarı)
GEMINI_API_KEY=buraya_kendi_gemini_api_anahtarinizi_yazin

# JWT Güvenlik
JWT_SECRET=NefesAI2026GizliAnahtar_Degistir_Production!@#

# E-posta (Gmail)
MAIL_USERNAME=nefes.bildirim@gmail.com
MAIL_PASSWORD=buraya_uygulama_sifrenizi_yazin

# Frontend URL
FRONTEND_URL=http://localhost:5173
